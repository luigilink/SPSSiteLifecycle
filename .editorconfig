root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PowerShell files keep a UTF-8 BOM and CRLF, like the other SPS* repositories: the BOM
# keeps non-ASCII characters readable by every host, and CRLF is the native line ending
# of the Windows machines the tool runs on.
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
